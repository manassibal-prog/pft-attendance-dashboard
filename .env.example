# Copy to .env for local dev. On Railway, set these as project Variables instead.

PORT=3000
TIMEZONE=Asia/Kolkata
ALLOWED_DOMAIN=wiom.in

# Google Sheet this app reads/writes (from the sheet's URL).
SPREADSHEET_ID=1rJw8-OKr98ebcn5KcjnLRfxvxuhKP0nL1IOQjm-XGQI

# Google Cloud service account with Sheets API access, shared as Editor on
# the sheet. Paste the full downloaded JSON key as one line, OR base64-encode
# it first (recommended — avoids private-key newline issues in most env-var
# UIs): base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Firebase project — Admin SDK service account JSON (Project settings >
# Service accounts > Generate new private key), same raw-or-base64 rule as
# above. Used server-side to verify sign-in tokens.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web app config (Project settings > General > Your apps > Web app)
# — these are public identifiers, safe to expose to the browser.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
